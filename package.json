{
  "name": "castle-keeper",
  "version": "0.1.0",
  "description": "A fast desktop client for Apache Kafka with production safeguards.",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/axlsoft/castle-keeper.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "check:tauri-versions": "node scripts/check-tauri-versions.mjs",
    "bindings": "cd src-tauri && cargo test --lib typescript_bindings_are_up_to_date",
    "test:integration": "bash scripts/test-integration.sh",
    "test": "vitest run",
    "check:version": "node scripts/check-version.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.55.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "runed": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
